{
	"name": "pronamic/wt-orbis-5",
	"description": "The default WordPress theme for Orbis.",
	"license": "GPL-2.0-or-later",
	"keywords": [
		"orbis",
		"wordpress",
		"theme",
		"bootstrap"
	],
	"homepage": "http://www.pronamic.eu/themes/orbis-5/",
	"authors": [
		{
			"name": "Remco Tolsma",
			"email": "info@remcotolsma.nl",
			"homepage": "http://www.remcotolsma.nl",
			"role": "Developer"
		},
		{
			"name": "Karel-Jan Tolsma",
			"email": "info@kareljantolsma.nl",
			"homepage": "http://www.kareljantolsma.nl",
			"role": "Developer"
		}
	],
	"support": {
		"email": "support@pronamic.nl",
		"issues": "https://github.com/pronamic/wt-orbis-5/issues",
		"source": "https://github.com/pronamic/wt-orbis-5"
	},
	"type": "wordpress-theme",
	"autoload": {
		"classmap": [
			"classes/"
		]
	},
	"config": {
		"allow-plugins": {
			"automattic/jetpack-autoloader": true,
			"dealerdirect/phpcodesniffer-composer-installer": true
		},
		"wp-slug": "orbis-5"
	},
	"require": {
		"pronamic/wp-money": "^2.4",
		"php": ">=5.2.0",
		"automattic/jetpack-autoloader": "^3.0"
	},
	"require-dev": {
		"phpmd/phpmd": "^2.4",
		"deployer/deployer": "^7.0",
		"pronamic/wp-coding-standards": "^2.1",
		"wp-cli/dist-archive-command": "*",
		"wp-cli/wp-cli-bundle": "*"
	},
	"scripts": {
		"build": [
			"rm -rf ./build/stage-1",
			"rm -rf ./build/orbis-5",
			"rsync --recursive --verbose --exclude-from=.distignore --exclude=/vendor/ ./ ./build/stage-1/",
			"composer install --no-dev --prefer-dist --optimize-autoloader --working-dir=./build/stage-1/",
			"rsync --recursive --verbose --exclude-from=.distignore ./build/stage-1/ ./build/orbis-5/",
			"vendor/bin/wp i18n make-pot ./build/orbis-5/ --slug=orbis-5",
			"vendor/bin/wp i18n make-mo ./build/orbis-5/languages/",
			"vendor/bin/wp dist-archive ./build/orbis-5/ --plugin-dirname=orbis-5 --force"
		],
		"dist-archive": "wp dist-archive . --plugin-dirname=orbis-5",
		"make-pot": [
			"@build",
			"rsync --recursive --delete --verbose ./build/orbis-5/languages/ ./languages/",
			"vendor/bin/wp i18n update-po ./languages/orbis-5.pot"
		],
		"phpcs": "vendor/bin/phpcs",
		"qa": [
			"@phpcs"
		]
	}
}
